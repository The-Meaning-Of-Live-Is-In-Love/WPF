<Window x:Class = "Code_Maker.MainWindow"
    xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local = "clr-namespace:Code_Maker"
    mc:Ignorable = "d"
    Title = "CM"
    Height = "1080"
    Width = "1920"
    WindowState = "Maximized"
	WindowStyle = "None"
	ResizeMode = "NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width = "Auto"/>
            <ColumnDefinition Width = "*"/>
            <ColumnDefinition Width = "200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column = "0" Margin = "15">
            <Button
            Margin = "10"
            MaxWidth = "150"
            MaxHeight = "30"
            HorizontalAlignment = "Left"
            Content = "Подключение библиотек"
            Name = "Library"
            Click = "Menu_Switching_Library">
            </Button>
        </StackPanel>
        <StackPanel Grid.Column = "1" Margin = "15">
            <ListView x:Name = "Libraryes_Text" ItemsSource = "{Binding Libraryes}"/>
        </StackPanel>
        <StackPanel Grid.Column = "2" Margin = "15">
            <ListView
            x:Name = "Buttons_Values"/>
        </StackPanel>
        <TextBox
            VerticalAlignment = "Bottom" 
            HorizontalAlignment = "Center" 
            Grid.Column = "1"
            x:Name = "Text_Box">
        </TextBox>
    </Grid>
</Window>